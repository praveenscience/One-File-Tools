<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{displayName}} — Resume</title>
  <style>
    /* ============================================================
       SWISS INTERNATIONAL TYPOGRAPHIC STYLE (ZURICH)
       Strict mathematical grid, flush-left grotesque typography,
       high-contrast hierarchy, and International Red accents.
       ============================================================ */

    /* === Reset & Box Model === */
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    /* === A4 Print Setup === */
    @page {
      size: A4;
      margin: 12mm 14mm;
    }

    /* === Design Tokens === */
    :root {
      --font-swiss: "Helvetica Neue", Helvetica, Arial, -apple-system, BlinkMacSystemFont, "Inter", sans-serif;
      --font-mono: "JetBrains Mono", "SFMono-Regular", Consolas, "Liberation Mono", Menlo, Courier, monospace;

      --swiss-black: #0c0d0e;
      --swiss-charcoal: #24272a;
      --swiss-gray: #555b62;
      --swiss-light-gray: #8d959e;
      --swiss-border: #e2e4e8;
      --swiss-rule: #0c0d0e;
      --swiss-red: #e11d48; /* International Swiss Red */
      --swiss-bg: #f5f6f8;
      --swiss-paper: #ffffff;

      --baseline: 8px;
    }

    html {
      background-color: var(--swiss-bg);
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }

    body {
      font-family: var(--font-swiss);
      font-size: 9.5pt;
      line-height: 1.45;
      color: var(--swiss-charcoal);
      background-color: var(--swiss-bg);
      padding: 24px 16px;
    }

    /* === Container Document Sheet === */
    .sheet {
      max-width: 210mm;
      min-height: 297mm;
      margin: 0 auto;
      background: var(--swiss-paper);
      padding: 36px 42px;
      box-shadow: 0 4px 28px rgba(0, 0, 0, 0.08);
      position: relative;
    }

    /* Top Red Geometry Mark */
    .sheet::before {
      content: "";
      position: absolute;
      top: 0;
      left: 42px;
      width: 32px;
      height: 4px;
      background: var(--swiss-red);
    }

    /* === Header: Heavy Grotesque Identity Banner === */
    header.header {
      margin-bottom: 24px;
      padding-bottom: 18px;
      border-bottom: 2px solid var(--swiss-rule);
    }

    .header-top {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      flex-wrap: wrap;
      gap: 12px;
      margin-bottom: 8px;
    }

    .name-block h1 {
      font-size: 26pt;
      font-weight: 900;
      letter-spacing: -0.035em;
      line-height: 1.05;
      color: var(--swiss-black);
      text-transform: uppercase;
    }

    .name-block .title {
      font-size: 11pt;
      font-weight: 700;
      color: var(--swiss-red);
      letter-spacing: -0.01em;
      margin-top: 4px;
      text-transform: uppercase;
    }

    .contact-compact {
      font-size: 8.5pt;
      color: var(--swiss-gray);
      text-align: right;
      line-height: 1.4;
    }

    .contact-compact a {
      color: var(--swiss-black);
      text-decoration: none;
      font-weight: 600;
    }

    .contact-compact a:hover {
      color: var(--swiss-red);
      text-decoration: underline;
    }

    /* === Two-Column Asymmetric Swiss Grid (1:2 Ratio) === */
    .layout-grid {
      display: grid;
      grid-template-columns: 2.2fr 4.8fr;
      gap: 32px;
      align-items: start;
    }

    @media (max-width: 680px) {
      .layout-grid {
        grid-template-columns: 1fr;
        gap: 20px;
      }
      .contact-compact {
        text-align: left;
      }
      .sheet {
        padding: 24px 20px;
      }
    }

    /* === Section Header Typography === */
    .sidebar section,
    .main-col section {
      margin-bottom: 22px;
    }

    .section-title {
      font-size: 8pt;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: var(--swiss-black);
      margin-bottom: 10px;
      display: flex;
      align-items: center;
      gap: 6px;
      border-bottom: 1px solid var(--swiss-border);
      padding-bottom: 4px;
    }

    .section-title::before {
      content: "";
      display: inline-block;
      width: 6px;
      height: 6px;
      background: var(--swiss-red);
    }

    /* === Summary / Profile === */
    .summary-text {
      font-size: 9.5pt;
      color: var(--swiss-charcoal);
      line-height: 1.5;
      margin-bottom: 6px;
    }

    /* === Experience & Projects (Articles) === */
    .entry-item {
      margin-bottom: 16px;
      page-break-inside: avoid;
      break-inside: avoid;
    }

    .entry-item:last-child {
      margin-bottom: 0;
    }

    .entry-header {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      flex-wrap: wrap;
      gap: 4px 12px;
      margin-bottom: 2px;
    }

    .entry-role {
      font-size: 10pt;
      font-weight: 800;
      color: var(--swiss-black);
      letter-spacing: -0.01em;
    }

    .entry-date {
      font-size: 8pt;
      font-weight: 700;
      font-family: var(--font-mono);
      color: var(--swiss-gray);
      white-space: nowrap;
    }

    .entry-company {
      font-size: 8.5pt;
      font-weight: 700;
      color: var(--swiss-gray);
      text-transform: uppercase;
      letter-spacing: 0.04em;
      margin-bottom: 4px;
    }

    .entry-company a {
      color: inherit;
      text-decoration: none;
    }

    .entry-company a:hover {
      color: var(--swiss-red);
    }

    .entry-desc {
      font-size: 9pt;
      color: var(--swiss-charcoal);
      margin-bottom: 6px;
    }

    .bullet-list {
      list-style: none;
      padding-left: 0;
    }

    .bullet-list li {
      position: relative;
      padding-left: 14px;
      font-size: 9pt;
      color: var(--swiss-charcoal);
      margin-bottom: 4px;
      line-height: 1.45;
    }

    .bullet-list li::before {
      content: "—";
      position: absolute;
      left: 0;
      color: var(--swiss-red);
      font-weight: 700;
    }

    /* Tech Stack Tags */
    .tech-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 4px;
      margin-top: 6px;
    }

    .tech-tag {
      font-family: var(--font-mono);
      font-size: 7.5pt;
      font-weight: 600;
      background: #f0f2f5;
      color: var(--swiss-black);
      padding: 1px 6px;
      border-radius: 2px;
    }

    /* === Sidebar Elements === */
    .contact-item {
      font-size: 8.5pt;
      margin-bottom: 6px;
      word-break: break-word;
    }

    .contact-label {
      font-size: 7.5pt;
      text-transform: uppercase;
      font-weight: 700;
      color: var(--swiss-light-gray);
      letter-spacing: 0.05em;
      display: block;
    }

    .contact-value a {
      color: var(--swiss-black);
      text-decoration: none;
      font-weight: 600;
    }

    .contact-value a:hover {
      color: var(--swiss-red);
    }

    /* Skills Grid */
    .skill-group {
      margin-bottom: 12px;
      page-break-inside: avoid;
      break-inside: avoid;
    }

    .skill-group-name {
      font-size: 8.5pt;
      font-weight: 800;
      color: var(--swiss-black);
      margin-bottom: 4px;
      text-transform: uppercase;
      letter-spacing: 0.02em;
    }

    .skill-keywords {
      font-size: 8.5pt;
      color: var(--swiss-gray);
      line-height: 1.4;
    }

    /* Education & Certifications */
    .edu-item, .cert-item {
      margin-bottom: 12px;
      page-break-inside: avoid;
      break-inside: avoid;
    }

    .edu-degree {
      font-size: 9pt;
      font-weight: 800;
      color: var(--swiss-black);
    }

    .edu-inst {
      font-size: 8pt;
      color: var(--swiss-gray);
      font-weight: 600;
    }

    .edu-date {
      font-size: 7.5pt;
      font-family: var(--font-mono);
      color: var(--swiss-light-gray);
      margin-top: 1px;
    }

    /* Languages */
    .lang-item {
      display: flex;
      justify-content: space-between;
      font-size: 8.5pt;
      margin-bottom: 4px;
      border-bottom: 1px dotted var(--swiss-border);
      padding-bottom: 2px;
    }

    .lang-name {
      font-weight: 700;
      color: var(--swiss-black);
    }

    .lang-level {
      color: var(--swiss-gray);
      font-size: 8pt;
      text-transform: capitalize;
    }

    /* Headline, tagline, links, small meta */
    .name-block .headline {
      font-size: 9pt;
      color: var(--swiss-gray);
      margin-top: 4px;
    }

    .entry-tagline {
      font-size: 8.5pt;
      color: var(--swiss-gray);
      font-style: italic;
      margin-bottom: 4px;
    }

    .entry-role a {
      color: inherit;
      text-decoration: none;
    }

    .entry-links {
      font-family: var(--font-mono);
      font-size: 7.5pt;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      margin-bottom: 4px;
    }

    .entry-links a {
      color: var(--swiss-red);
      text-decoration: none;
      margin-right: 10px;
    }

    .entry-links a:hover {
      text-decoration: underline;
    }

    .edu-honors {
      font-size: 8pt;
      color: var(--swiss-gray);
      margin-top: 2px;
    }

    .edu-gpa {
      font-family: var(--font-mono);
      font-size: 7.5pt;
      color: var(--swiss-gray);
    }

    .interest-list {
      font-size: 8.5pt;
      color: var(--swiss-gray);
      line-height: 1.5;
    }

    /* === Footer === */
    .site-footer {
      margin-top: 24px;
      padding-top: 8px;
      border-top: 1px solid var(--swiss-border);
      font-family: var(--font-mono);
      font-size: 7pt;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--swiss-light-gray);
    }

    .site-footer a {
      color: var(--swiss-red);
      text-decoration: none;
    }

    /* === Print Overrides === */
    @media print {
      html, body {
        background: #ffffff !important;
        padding: 0 !important;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
      }

      .sheet {
        max-width: 100% !important;
        min-height: auto !important;
        margin: 0 !important;
        padding: 0 !important;
        box-shadow: none !important;
      }

      .sheet::before {
        display: none !important;
      }

      .tech-tag {
        border: 1px solid #dddddd;
      }

      a {
        text-decoration: none !important;
      }
    }
  </style>
</head>
<body>

  <main class="sheet">
    <!-- Header -->
    <header class="header">
      <div class="header-top">
        <div class="name-block">
          <h1>{{displayName}}</h1>
          {{#if title}}
            <div class="title">{{title}}</div>
          {{/if}}
          {{#if headline}}
            <div class="headline">{{headline}}</div>
          {{/if}}
        </div>

        <address class="contact-compact">
          {{#if email}}
            <div><a href="mailto:{{email}}">{{email}}</a></div>
          {{/if}}
          {{#if phone}}
            <div><a href="tel:{{tel phone}}">{{phone}}</a></div>
          {{/if}}
          {{#if website}}
            <div><a href="{{website}}">{{stripProtocol website}}</a></div>
          {{/if}}
          {{#if locationStr}}
            <div>{{locationStr}}</div>
          {{/if}}
        </address>
      </div>
    </header>

    <!-- Asymmetric Swiss Layout Grid -->
    <div class="layout-grid">
      <!-- Left Column (Sidebar: Contacts, Skills, Education, Certifications, Languages, Interests) -->
      <aside class="sidebar">
        <!-- Contact & Links -->
        {{#has socialLinks}}
        <section aria-labelledby="sec-contact">
          <h2 class="section-title" id="sec-contact">Connect</h2>
          {{#each socialLinks}}
            <div class="contact-item">
              <span class="contact-label">{{label}}</span>
              <span class="contact-value"><a href="{{url}}" target="_blank" rel="noopener">{{stripProtocol url}}</a></span>
            </div>
          {{/each}}
        </section>
        {{/has}}

        <!-- Skills -->
        {{#has skills}}
        <section aria-labelledby="sec-skills">
          <h2 class="section-title" id="sec-skills">Expertise</h2>
          {{#each skills}}
            <div class="skill-group">
              <div class="skill-group-name">{{category}}</div>
              {{#has items}}
                <div class="skill-keywords">{{joinField items "name" ", "}}</div>
              {{/has}}
            </div>
          {{/each}}
        </section>
        {{/has}}

        <!-- Education -->
        {{#has education}}
        <section aria-labelledby="sec-education">
          <h2 class="section-title" id="sec-education">Education</h2>
          {{#each education}}
            <div class="edu-item">
              <div class="edu-degree">{{degree}}{{#if field}} in {{field}}{{/if}}</div>
              <div class="edu-inst">{{institution}}</div>
              <div class="edu-date">{{fmtDate startDate}} — {{fmtDate endDate}}</div>
              {{#if gpa}}<div class="edu-gpa">GPA {{gpa}}</div>{{/if}}
              {{#has honors}}<div class="edu-honors">{{join honors " · "}}</div>{{/has}}
            </div>
          {{/each}}
        </section>
        {{/has}}

        <!-- Certifications -->
        {{#has certifications}}
        <section aria-labelledby="sec-certifications">
          <h2 class="section-title" id="sec-certifications">Certifications</h2>
          {{#each certifications}}
            <div class="cert-item">
              <div class="edu-degree">{{name}}</div>
              {{#if issuer}}<div class="edu-inst">{{issuer}}</div>{{/if}}
              {{#if date}}<div class="edu-date">{{fmtDate date}}</div>{{/if}}
            </div>
          {{/each}}
        </section>
        {{/has}}

        <!-- Languages -->
        {{#has languages}}
        <section aria-labelledby="sec-languages">
          <h2 class="section-title" id="sec-languages">Languages</h2>
          {{#each languages}}
            <div class="lang-item">
              <span class="lang-name">{{language}}</span>
              {{#if proficiency}}<span class="lang-level">{{proficiency}}</span>{{/if}}
            </div>
          {{/each}}
        </section>
        {{/has}}

        <!-- Interests -->
        {{#has interests}}
        <section aria-labelledby="sec-interests">
          <h2 class="section-title" id="sec-interests">Interests</h2>
          <p class="interest-list">{{join interests " · "}}</p>
        </section>
        {{/has}}
      </aside>

      <!-- Right Column (Main: Summary, Experience, Projects, Volunteer, Publications, Awards) -->
      <div class="main-col">
        <!-- Professional Summary -->
        {{#if summary}}
        <section aria-labelledby="sec-summary">
          <h2 class="section-title" id="sec-summary">Profile</h2>
          <p class="summary-text">{{summary}}</p>
        </section>
        {{/if}}

        <!-- Work Experience -->
        {{#has experience}}
        <section aria-labelledby="sec-experience">
          <h2 class="section-title" id="sec-experience">Experience</h2>
          {{#each experience}}
            <article class="entry-item">
              <div class="entry-header">
                <span class="entry-role">{{role}}</span>
                <span class="entry-date">{{fmtDate startDate}} — {{fmtDate endDate}}</span>
              </div>
              <div class="entry-company">
                {{#if url}}<a href="{{url}}" target="_blank" rel="noopener">{{company}}</a>{{else}}{{company}}{{/if}}{{#if location}} · {{location}}{{/if}}
              </div>
              {{#if description}}
                <p class="entry-desc">{{description}}</p>
              {{/if}}
              {{#has highlights}}
                <ul class="bullet-list">
                  {{#each highlights}}
                    <li>{{.}}</li>
                  {{/each}}
                </ul>
              {{/has}}
            </article>
          {{/each}}
        </section>
        {{/has}}

        <!-- Featured Projects -->
        {{#has projects}}
        <section aria-labelledby="sec-projects">
          <h2 class="section-title" id="sec-projects">Projects</h2>
          {{#each projects}}
            <article class="entry-item">
              <div class="entry-header">
                <span class="entry-role">
                  {{#if liveUrl}}<a href="{{liveUrl}}" target="_blank" rel="noopener">{{name}}</a>{{else if repoUrl}}<a href="{{repoUrl}}" target="_blank" rel="noopener">{{name}}</a>{{else}}{{name}}{{/if}}
                </span>
                {{#if year}}<span class="entry-date">{{year}}</span>{{/if}}
              </div>
              {{#if tagline}}<div class="entry-tagline">{{tagline}}</div>{{/if}}
              {{#if liveUrl}}
                <div class="entry-links"><a href="{{liveUrl}}" target="_blank" rel="noopener">Live</a>{{#if repoUrl}}<a href="{{repoUrl}}" target="_blank" rel="noopener">Source</a>{{/if}}</div>
              {{else if repoUrl}}
                <div class="entry-links"><a href="{{repoUrl}}" target="_blank" rel="noopener">Source</a></div>
              {{/if}}
              {{#if description}}
                <p class="entry-desc">{{description}}</p>
              {{/if}}
              {{#has highlights}}
                <ul class="bullet-list">
                  {{#each highlights}}
                    <li>{{.}}</li>
                  {{/each}}
                </ul>
              {{/has}}
              {{#has techStack}}
                <div class="tech-tags">
                  {{#each techStack}}
                    <span class="tech-tag">{{.}}</span>
                  {{/each}}
                </div>
              {{/has}}
            </article>
          {{/each}}
        </section>
        {{/has}}

        <!-- Volunteer -->
        {{#has volunteer}}
        <section aria-labelledby="sec-volunteer">
          <h2 class="section-title" id="sec-volunteer">Volunteer</h2>
          {{#each volunteer}}
            <article class="entry-item">
              <div class="entry-header">
                <span class="entry-role">{{role}}</span>
                <span class="entry-date">{{fmtDate startDate}} — {{fmtDate endDate}}</span>
              </div>
              <div class="entry-company">
                {{#if url}}<a href="{{url}}" target="_blank" rel="noopener">{{organization}}</a>{{else}}{{organization}}{{/if}}
              </div>
              {{#if description}}
                <p class="entry-desc">{{description}}</p>
              {{/if}}
            </article>
          {{/each}}
        </section>
        {{/has}}

        <!-- Publications -->
        {{#has publications}}
        <section aria-labelledby="sec-publications">
          <h2 class="section-title" id="sec-publications">Publications</h2>
          {{#each publications}}
            <article class="entry-item">
              <div class="entry-header">
                <span class="entry-role">{{#if url}}<a href="{{url}}" target="_blank" rel="noopener">{{title}}</a>{{else}}{{title}}{{/if}}</span>
                {{#if date}}<span class="entry-date">{{fmtDate date}}</span>{{/if}}
              </div>
              {{#if publisher}}<div class="entry-company">{{publisher}}</div>{{/if}}
            </article>
          {{/each}}
        </section>
        {{/has}}

        <!-- Awards -->
        {{#has awards}}
        <section aria-labelledby="sec-awards">
          <h2 class="section-title" id="sec-awards">Awards</h2>
          {{#each awards}}
            <article class="entry-item">
              <div class="entry-header">
                <span class="entry-role">{{title}}</span>
                {{#if date}}<span class="entry-date">{{fmtDate date}}</span>{{/if}}
              </div>
              {{#if issuer}}<div class="entry-company">{{issuer}}</div>{{/if}}
              {{#if description}}
                <p class="entry-desc">{{description}}</p>
              {{/if}}
            </article>
          {{/each}}
        </section>
        {{/has}}
      </div>
    </div>

    <footer class="site-footer">
      <p>Built with <a href="{{toolsUrl}}">One File Tools</a></p>
    </footer>
  </main>

</body>
</html>
