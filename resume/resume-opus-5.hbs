<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{personal.displayName}} · {{personal.title}}</title>
<meta name="description" content="{{personal.headline}}">

<!--
  Typefaces: Oxanium (display), Quicksand (headings), Nunito (body), Rajdhani (labels/data).
  The file is fully offline and falls back to ui-rounded / system-ui when these are not installed.
  To force the exact faces, uncomment the line below (adds a network dependency):
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Oxanium:wght@400;600;700&family=Quicksand:wght@400;500;600;700&family=Nunito:ital,wght@0,400;0,600;0,700;1,400&family=Rajdhani:wght@500;600;700&display=swap">
-->

<style>
/* ============================================================
   TOKENS
   ============================================================ */
:root{
  /* type roles */
  --font-display: 'Oxanium', 'Quicksand', ui-rounded, system-ui, -apple-system, sans-serif;
  --font-head:    'Quicksand', 'Nunito', ui-rounded, system-ui, -apple-system, sans-serif;
  --font-body:    'Nunito', 'Quicksand', ui-rounded, system-ui, -apple-system, sans-serif;
  --font-label:   'Rajdhani', 'Oxanium', ui-sans-serif, system-ui, sans-serif;

  /* ink + surface */
  --paper:#ffffff;
  --bg:#f3f5f7;
  --ink:#0f1317;
  --ink-2:#303845;
  --muted:#69727f;
  --faint:#98a0ac;
  --line:#e6e9ee;
  --line-2:#eff1f5;
  --wash:#f7f8fa;

  /* accent — muted deep teal, one warm brass for honours */
  --accent:#1c6f68;
  --accent-deep:#12514c;
  --accent-soft:#ecf5f3;
  --accent-line:#cfe4e0;
  --brass:#836327;
  --brass-soft:#f8f4ea;
  --brass-line:#e9dfc7;

  /* radii — generous, to sit with the rounded type */
  --r-xs:8px; --r-sm:12px; --r-md:16px; --r-lg:22px; --r-xl:30px; --r-pill:999px;

  /* spacing scale */
  --s1:4px; --s2:8px; --s3:12px; --s4:16px; --s5:22px; --s6:30px;
  --s7:42px; --s8:56px; --s9:76px;

  --shadow-sm:0 1px 2px rgba(15,19,23,.045);
  --shadow-md:0 1px 2px rgba(15,19,23,.04), 0 10px 24px -16px rgba(15,19,23,.16);
  --shadow-lg:0 2px 4px rgba(15,19,23,.03), 0 48px 90px -50px rgba(15,19,23,.28);
}

/* ============================================================
   BASE
   ============================================================ */
*,*::before,*::after{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{
  margin:0;
  background:var(--bg);
  color:var(--ink-2);
  font-family:var(--font-body);
  font-size:15px;
  line-height:1.62;
  letter-spacing:.002em;
  -webkit-font-smoothing:antialiased;
  text-rendering:optimizeLegibility;
  padding:clamp(0px,4vw,var(--s9)) clamp(0px,4vw,var(--s6));
}
img{max-width:100%;display:block}
ul,ol{margin:0;padding:0;list-style:none}
p{margin:0}
h1,h2,h3,h4{margin:0;color:var(--ink);font-weight:600}
a{color:inherit;text-decoration:none}
a:focus-visible,button:focus-visible{
  outline:2px solid var(--accent);
  outline-offset:3px;
  border-radius:var(--r-xs);
}

/* the sheet */
.sheet{
  max-width:1100px;
  margin:0 auto;
  background:var(--paper);
  border:1px solid var(--line);
  border-radius:var(--r-xl);
  box-shadow:var(--shadow-lg);
  padding:clamp(var(--s5),4.5vw,var(--s8));
  overflow:hidden;
}

/* ============================================================
   SHARED PRIMITIVES
   ============================================================ */
.label{
  font-family:var(--font-label);
  font-size:11.5px;
  font-weight:600;
  letter-spacing:.14em;
  text-transform:uppercase;
  color:var(--faint);
  line-height:1.4;
}
.data{
  font-family:var(--font-label);
  font-size:13.5px;
  font-weight:600;
  letter-spacing:.03em;
  color:var(--muted);
  font-variant-numeric:tabular-nums;
}
.section{margin-top:var(--s8)}
.section__head{
  display:flex;
  align-items:baseline;
  gap:var(--s4);
  margin-bottom:var(--s5);
}
.section__title{
  font-family:var(--font-display);
  font-size:15px;
  font-weight:700;
  letter-spacing:.1em;
  text-transform:uppercase;
  color:var(--ink);
  white-space:nowrap;
}
.section__rule{
  flex:1;
  height:1px;
  background:linear-gradient(90deg,var(--line),transparent);
}
.section__note{font-family:var(--font-label);font-size:12.5px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--faint)}

.card{
  background:var(--paper);
  border:1px solid var(--line);
  border-radius:var(--r-lg);
  padding:var(--s5);
  break-inside:avoid;
  page-break-inside:avoid;
  transition:border-color .18s ease, box-shadow .18s ease, transform .18s ease;
}
.card:hover{border-color:var(--accent-line);box-shadow:var(--shadow-md)}

.chips{display:flex;flex-wrap:wrap;gap:var(--s2)}
.chip{
  font-family:var(--font-label);
  font-size:12.5px;
  font-weight:600;
  letter-spacing:.05em;
  color:var(--muted);
  background:var(--wash);
  border:1px solid var(--line);
  border-radius:var(--r-pill);
  padding:3px 11px 2px;
  white-space:nowrap;
}
.badge{
  display:inline-flex;
  align-items:center;
  gap:6px;
  font-family:var(--font-label);
  font-size:11.5px;
  font-weight:700;
  letter-spacing:.1em;
  text-transform:uppercase;
  color:var(--accent-deep);
  background:var(--accent-soft);
  border:1px solid var(--accent-line);
  border-radius:var(--r-pill);
  padding:2px 10px 1px;
}
.badge::before{
  content:"";
  width:5px;height:5px;border-radius:50%;
  background:var(--accent);
}
.bullets{display:grid;gap:var(--s2);margin-top:var(--s3)}
.bullets li{position:relative;padding-left:var(--s5);color:var(--ink-2)}
.bullets li::before{
  content:"";
  position:absolute;left:2px;top:.72em;
  width:9px;height:2px;border-radius:2px;
  background:var(--accent);
  opacity:.55;
}
.ext{
  font-family:var(--font-label);
  font-size:12.5px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;
  color:var(--accent-deep);
  border-bottom:1px solid var(--accent-line);
  padding-bottom:1px;
  white-space:nowrap;
}
.ext::after{content:" \2197";font-size:11px}
.ext:hover{border-bottom-color:var(--accent)}

/* ============================================================
   HERO
   ============================================================ */
.hero{
  display:grid;
  grid-template-columns:minmax(0,1.55fr) minmax(280px,1fr);
  gap:clamp(var(--s5),3vw,var(--s7));
  align-items:start;
}
.hero__id{display:flex;gap:var(--s5);align-items:flex-start}
.avatar{
  margin:0;
  flex:none;
  width:clamp(88px,11vw,124px);
  aspect-ratio:1/1;
  border-radius:26px;
  padding:4px;
  background:var(--paper);
  border:1px solid var(--line);
  box-shadow:var(--shadow-sm);
}
.avatar img{width:100%;height:100%;object-fit:cover;border-radius:22px}
.hero__kicker{margin-bottom:var(--s2)}
.name{
  font-family:var(--font-display);
  font-size:clamp(2.35rem,5.4vw,3.5rem);
  line-height:1.02;
  letter-spacing:-.02em;
  font-weight:700;
}
.name span{font-weight:300;color:var(--ink-2)}
.headline{
  font-family:var(--font-head);
  font-size:clamp(1rem,1.5vw,1.14rem);
  font-weight:500;
  color:var(--muted);
  margin-top:var(--s3);
  max-width:44ch;
}
.hero__meta{
  display:flex;flex-wrap:wrap;align-items:center;gap:var(--s2) var(--s4);
  margin-top:var(--s4);
}
.hero__place{
  font-family:var(--font-label);
  font-size:13.5px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;
  color:var(--ink-2);
}

/* contact panel */
.contact{
  background:var(--wash);
  border:1px solid var(--line);
  border-radius:var(--r-lg);
  padding:var(--s5);
}
.contact__list{display:grid;gap:var(--s4)}
.contact__row{display:grid;gap:2px}
.contact__value{
  font-family:var(--font-head);
  font-size:14.5px;
  font-weight:600;
  color:var(--ink);
  word-break:break-word;
}
a.contact__value:hover{color:var(--accent-deep)}
.social{
  display:flex;flex-wrap:wrap;gap:var(--s2);
  margin-top:var(--s5);
  padding-top:var(--s4);
  border-top:1px solid var(--line);
}
.social a{
  font-family:var(--font-label);
  font-size:12.5px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;
  color:var(--ink-2);
  background:var(--paper);
  border:1px solid var(--line);
  border-radius:var(--r-pill);
  padding:4px 12px 3px;
  transition:border-color .18s ease,color .18s ease;
}
.social a:hover{color:var(--accent-deep);border-color:var(--accent-line)}

/* ============================================================
   SUMMARY / BIO
   ============================================================ */
.summary{
  margin-top:var(--s8);
  padding-top:var(--s7);
  border-top:1px solid var(--line);
  display:grid;
  grid-template-columns:150px minmax(0,1fr);
  gap:var(--s5);
}
.summary__body{display:grid;gap:var(--s4)}
.summary__lead{
  font-family:var(--font-head);
  font-size:clamp(1.06rem,1.7vw,1.26rem);
  font-weight:500;
  line-height:1.55;
  color:var(--ink);
  letter-spacing:-.004em;
}
.summary__bio{color:var(--muted);max-width:72ch}

/* ============================================================
   SKILLS
   ============================================================ */
.skillgrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:var(--s4)}
.skillcard{padding:var(--s5)}
.skillcard h3{
  font-family:var(--font-display);
  font-size:13px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;
  color:var(--accent-deep);
  margin-bottom:var(--s4);
}
.skills{display:grid;gap:var(--s2)}
.skill{
  display:flex;align-items:center;justify-content:space-between;gap:var(--s3);
  border-radius:var(--r-sm);
  padding:5px 10px 4px;
  border:1px solid transparent;
  background:var(--wash);
}
.skill__name{font-family:var(--font-head);font-size:14px;font-weight:500;color:var(--ink-2)}
.skill__level{
  font-family:var(--font-label);
  font-size:10.5px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;
  color:var(--faint);
  display:flex;align-items:center;gap:6px;
  white-space:nowrap;
}
.skill__level::after{content:"\25CF\25CB\25CB";letter-spacing:1px;font-size:8px;color:var(--line)}
.skill[data-level="intermediate"] .skill__level::after{color:var(--faint)}
.skill[data-level="advanced"]{background:#f4f7f7;border-color:#e4edec}
.skill[data-level="advanced"] .skill__name{color:var(--ink)}
.skill[data-level="advanced"] .skill__level{color:var(--muted)}
.skill[data-level="advanced"] .skill__level::after{content:"\25CF\25CF\25CB";color:var(--accent);opacity:.6}
.skill[data-level="expert"]{background:var(--accent-soft);border-color:var(--accent-line)}
.skill[data-level="expert"] .skill__name{color:var(--ink);font-weight:700}
.skill[data-level="expert"] .skill__level{color:var(--accent-deep)}
.skill[data-level="expert"] .skill__level::after{content:"\25CF\25CF\25CF";color:var(--accent)}

/* ============================================================
   EXPERIENCE — the spine
   ============================================================ */
.timeline{display:grid;gap:var(--s5)}
.xp{
  display:grid;
  grid-template-columns:14px minmax(0,1fr);
  gap:var(--s5);
  break-inside:avoid;
  page-break-inside:avoid;
}
.xp__spine{position:relative;display:flex;justify-content:center}
.xp__spine::before{
  content:"";
  position:absolute;top:26px;bottom:-30px;
  width:2px;border-radius:2px;
  background:var(--line-2);
}
.timeline .xp:last-child .xp__spine::before{display:none}
.xp__node{
  position:relative;z-index:1;
  margin-top:19px;
  width:12px;height:12px;border-radius:50%;
  background:var(--paper);
  border:2px solid var(--line);
}
.xp--current .xp__node{border-color:var(--accent);box-shadow:0 0 0 4px var(--accent-soft)}

.xp__card{padding:var(--s5) var(--s5) var(--s5)}
.xp__top{
  display:flex;flex-wrap:wrap;gap:var(--s4);
  align-items:flex-start;justify-content:space-between;
}
.xp__ident{display:flex;gap:var(--s4);align-items:flex-start;min-width:0}
.logo{
  flex:none;width:42px;height:42px;
  border-radius:var(--r-sm);
  border:1px solid var(--line);
  background:var(--paper);
  object-fit:contain;
  padding:4px;
}
.xp__role{
  font-family:var(--font-head);
  font-size:clamp(1.08rem,1.5vw,1.22rem);
  font-weight:700;
  letter-spacing:-.008em;
  line-height:1.28;
}
.xp__org{
  display:flex;flex-wrap:wrap;align-items:center;gap:var(--s2) var(--s3);
  margin-top:4px;
}
.xp__company{
  font-family:var(--font-head);
  font-size:14.5px;font-weight:600;color:var(--accent-deep);
}
.xp__dot{width:3px;height:3px;border-radius:50%;background:var(--faint);opacity:.7}
.xp__type{text-transform:capitalize}
.xp__when{text-align:right;display:grid;gap:4px;justify-items:end;margin-left:auto}
.xp__dates{font-family:var(--font-label);font-size:13.5px;font-weight:700;letter-spacing:.04em;color:var(--ink-2);font-variant-numeric:tabular-nums;white-space:nowrap}
.xp__desc{margin-top:var(--s4);color:var(--muted)}
.xp__card .chips{margin-top:var(--s4);padding-top:var(--s4);border-top:1px solid var(--line-2)}

/* ============================================================
   PROJECTS
   ============================================================ */
.projects--featured{display:grid;gap:var(--s4)}
.pj{overflow:hidden;padding:0}
.pj__inner{display:grid;grid-template-columns:minmax(200px,.8fr) minmax(0,1.6fr);gap:0}
.pj__shot{margin:0;background:var(--wash);border-right:1px solid var(--line-2);overflow:hidden}
.pj__shot img{width:100%;height:100%;min-height:170px;object-fit:cover}
.pj__body{padding:var(--s5)}
.pj__head{display:flex;flex-wrap:wrap;align-items:baseline;gap:var(--s3);justify-content:space-between}
.pj__name{font-family:var(--font-display);font-size:1.2rem;font-weight:700;letter-spacing:-.01em}
.pj__tagline{font-family:var(--font-head);font-size:14.5px;font-weight:600;color:var(--accent-deep);margin-top:2px}
.pj__desc{margin-top:var(--s3);color:var(--muted)}
.pj__links{display:flex;flex-wrap:wrap;gap:var(--s4);margin-top:var(--s4)}
.pj__body .chips{margin-top:var(--s4)}
.projects--minor{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:var(--s4);margin-top:var(--s4)}
.pj--minor .pj__body{padding:var(--s5)}
.pj--minor .pj__name{font-size:1.06rem}

/* ============================================================
   EDUCATION
   ============================================================ */
.edu{display:grid;grid-template-columns:minmax(0,1fr);gap:var(--s4)}
.edu__card{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:var(--s4);align-items:start}
.edu__degree{font-family:var(--font-head);font-size:1.12rem;font-weight:700;letter-spacing:-.008em}
.edu__inst{font-family:var(--font-head);font-size:14.5px;font-weight:600;color:var(--accent-deep);margin-top:3px}
.edu__facts{display:flex;flex-wrap:wrap;gap:var(--s2) var(--s4);margin-top:var(--s3)}
.edu__gpa{font-family:var(--font-label);font-size:13.5px;font-weight:700;letter-spacing:.04em;color:var(--ink-2)}
.edu__honours{display:flex;flex-wrap:wrap;gap:var(--s2);margin-top:var(--s3)}
.honour{
  font-family:var(--font-label);
  font-size:12px;font-weight:700;letter-spacing:.07em;text-transform:uppercase;
  color:var(--brass);background:var(--brass-soft);border:1px solid var(--brass-line);
  border-radius:var(--r-pill);padding:3px 11px 2px;
}
.edu__courses{margin-top:var(--s4);padding-top:var(--s4);border-top:1px solid var(--line-2)}
.edu__courses .label{margin-bottom:var(--s2)}

/* ============================================================
   GENERIC GRIDS (certs, talks, awards, volunteer)
   ============================================================ */
.grid-2{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:var(--s4)}
.tile__title{font-family:var(--font-head);font-size:1.04rem;font-weight:700;line-height:1.35;letter-spacing:-.006em}
.tile__sub{font-family:var(--font-head);font-size:14px;font-weight:600;color:var(--accent-deep);margin-top:3px}
.tile__meta{display:flex;flex-wrap:wrap;align-items:center;gap:var(--s2) var(--s3);margin-top:var(--s3)}
.tile__foot{display:flex;flex-wrap:wrap;gap:var(--s4);margin-top:var(--s4);padding-top:var(--s3);border-top:1px solid var(--line-2)}
.cred{font-family:var(--font-label);font-size:12.5px;font-weight:600;letter-spacing:.06em;color:var(--faint)}

/* publications — magazine rows */
.pubs{display:grid;gap:0;border-top:1px solid var(--line)}
.pub{
  display:grid;grid-template-columns:minmax(0,1fr) auto;gap:var(--s4);align-items:center;
  padding:var(--s4) var(--s2);
  border-bottom:1px solid var(--line);
  break-inside:avoid;page-break-inside:avoid;
}
.pub__title{font-family:var(--font-head);font-size:1.08rem;font-weight:600;letter-spacing:-.008em;line-height:1.35}
.pub__meta{display:flex;flex-wrap:wrap;align-items:center;gap:var(--s2) var(--s3);margin-top:4px}
.pub__pub{font-family:var(--font-head);font-size:13.5px;font-weight:600;color:var(--accent-deep)}
.pub__type{text-transform:capitalize}

/* awards */
.award{
  background:linear-gradient(180deg,var(--brass-soft),var(--paper) 78%);
  border-color:var(--brass-line);
}
.award::before{
  content:"\2605";
  display:block;
  font-size:15px;color:var(--brass);
  margin-bottom:var(--s2);
  line-height:1;
}
.award:hover{border-color:var(--brass-line);box-shadow:var(--shadow-md)}

/* languages + interests */
.pills{display:flex;flex-wrap:wrap;gap:var(--s3)}
.lang{
  display:flex;align-items:baseline;gap:var(--s3);
  border:1px solid var(--line);
  border-radius:var(--r-pill);
  padding:6px 16px 5px;
  background:var(--paper);
}
.lang__name{font-family:var(--font-head);font-size:14.5px;font-weight:700;color:var(--ink)}
.lang__prof{font-family:var(--font-label);font-size:11.5px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--faint)}
.interest{
  font-family:var(--font-head);
  font-size:14px;font-weight:600;color:var(--ink-2);
  background:var(--wash);border:1px solid var(--line);
  border-radius:var(--r-pill);padding:5px 15px 4px;
}

/* testimonials */
.quotes{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:var(--s4)}
.quote{position:relative;padding:var(--s6) var(--s5) var(--s5);background:var(--wash)}
.quote::before{
  content:"\201C";
  position:absolute;top:14px;left:var(--s5);
  font-family:var(--font-display);
  font-size:56px;line-height:1;
  color:var(--accent);opacity:.16;
}
.quote blockquote{margin:0;font-family:var(--font-head);font-size:15.5px;font-weight:500;line-height:1.62;color:var(--ink);position:relative}
.quote figcaption{display:flex;align-items:center;gap:var(--s3);margin-top:var(--s5);padding-top:var(--s4);border-top:1px solid var(--line)}
.quote figcaption img{width:38px;height:38px;border-radius:var(--r-pill);object-fit:cover;border:1px solid var(--line);flex:none}
.quote__who{font-family:var(--font-head);font-size:14px;font-weight:700;color:var(--ink)}
.quote__role{font-family:var(--font-label);font-size:12px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:var(--faint)}

/* footer */
.foot{
  margin-top:var(--s8);padding-top:var(--s5);
  border-top:1px solid var(--line);
  display:flex;flex-wrap:wrap;gap:var(--s3);justify-content:space-between;align-items:baseline;
}

/* ============================================================
   RESPONSIVE
   ============================================================ */
@media (max-width:920px){
  .hero{grid-template-columns:minmax(0,1fr)}
  .summary{grid-template-columns:minmax(0,1fr);gap:var(--s3)}
  .pj__inner{grid-template-columns:minmax(0,1fr)}
  .pj__shot{border-right:0;border-bottom:1px solid var(--line-2)}
  .pj__shot img{min-height:0;max-height:230px}
}
@media (max-width:620px){
  body{font-size:14.5px;padding:0}
  .sheet{border-radius:0;border-left:0;border-right:0;box-shadow:none;padding:var(--s5) var(--s4)}
  .hero__id{flex-direction:column;gap:var(--s4)}
  .xp{grid-template-columns:minmax(0,1fr);gap:var(--s3)}
  .xp__spine{display:none}
  .xp__when{text-align:left;justify-items:start;margin-left:0}
  .edu__card{grid-template-columns:minmax(0,1fr)}
  .pub{grid-template-columns:minmax(0,1fr)}
  .section{margin-top:var(--s7)}
}

@media (prefers-reduced-motion:reduce){
  *{transition:none !important;animation:none !important}
}

/* ============================================================
   PRINT
   ============================================================ */
@page{size:A4;margin:11mm 12mm}
@media print{
  :root{--bg:#fff}
  html,body{background:#fff}
  body{
    font-size:9.6pt;line-height:1.48;padding:0;
    print-color-adjust:exact;
    -webkit-print-color-adjust:exact;
  }
  .sheet{
    max-width:none;border:0;border-radius:0;box-shadow:none;padding:0;
  }
  .card,.skill,.chip,.lang,.interest,.quote,.avatar,.logo{box-shadow:none !important}
  .card:hover,.award:hover{box-shadow:none;border-color:var(--line)}
  a{color:inherit}
  .ext{border-bottom:0}
  .section{margin-top:14pt;break-inside:avoid}
  .section__head{margin-bottom:8pt}
  .section__title{font-size:9.5pt}
  .summary{margin-top:14pt;padding-top:12pt;grid-template-columns:110px minmax(0,1fr)}
  .name{font-size:27pt}
  .headline{font-size:10.5pt;margin-top:5pt}
  .summary__lead{font-size:11pt}
  .avatar{width:82px}
  .contact{padding:10pt}
  .social{margin-top:10pt;padding-top:8pt}
  .card,.xp,.pub,.quote,.skillcard,.pj,.edu__card,figure,section{break-inside:avoid;page-break-inside:avoid}
  h1,h2,h3{break-after:avoid;page-break-after:avoid}
  .xp__card{padding:11pt}
  .bullets{gap:3pt}
  .timeline{gap:11pt}
  .pj__shot img{max-height:130px}
  .foot{margin-top:16pt;padding-top:8pt}
}
</style>
</head>

<body>
<main class="sheet">

  <!-- ================= HERO ================= -->
  <header class="hero">
    <div class="hero__id">
      {{#if personal.photo}}
      <figure class="avatar">
        <img src="{{personal.photo}}" alt="Portrait of {{personal.displayName}}">
      </figure>
      {{/if}}
      <div>
        {{#if personal.title}}<p class="label hero__kicker">{{personal.title}}</p>{{/if}}
        <h1 class="name">{{personal.firstName}} <span>{{personal.lastName}}</span></h1>
        {{#if personal.headline}}<p class="headline">{{personal.headline}}</p>{{/if}}
        <div class="hero__meta">
          {{#with personal.location}}
          {{#if city}}
          <p class="hero__place">{{city}}{{#if state}}, {{state}}{{/if}}{{#if country}} &middot; {{country}}{{/if}}</p>
          {{/if}}
          {{#if remote}}<span class="badge">Open to remote</span>{{/if}}
          {{/with}}
        </div>
      </div>
    </div>

    <aside class="contact" aria-label="Contact details">
      <div class="contact__list">
        {{#with personal.contact}}
        {{#if email}}
        <div class="contact__row">
          <span class="label">Email</span>
          <a class="contact__value" href="mailto:{{email}}">{{email}}</a>
        </div>
        {{/if}}
        {{#if phone}}
        <div class="contact__row">
          <span class="label">Phone</span>
          <a class="contact__value" href="tel:{{phone}}">{{phone}}</a>
        </div>
        {{/if}}
        {{#if website}}
        <div class="contact__row">
          <span class="label">Website</span>
          <a class="contact__value" href="{{website}}" rel="noopener">{{website}}</a>
        </div>
        {{/if}}
        {{/with}}
      </div>

      {{#with personal.social}}
      <nav class="social" aria-label="Profiles">
        {{#if github}}<a href="{{github}}" rel="noopener">GitHub</a>{{/if}}
        {{#if linkedin}}<a href="{{linkedin}}" rel="noopener">LinkedIn</a>{{/if}}
        {{#if twitter}}<a href="{{twitter}}" rel="noopener">Twitter</a>{{/if}}
        {{#if blog}}<a href="{{blog}}" rel="noopener">Blog</a>{{/if}}
        {{#if youtube}}<a href="{{youtube}}" rel="noopener">YouTube</a>{{/if}}
        {{#if stackoverflow}}<a href="{{stackoverflow}}" rel="noopener">Stack Overflow</a>{{/if}}
        {{#if medium}}<a href="{{medium}}" rel="noopener">Medium</a>{{/if}}
        {{#if devto}}<a href="{{devto}}" rel="noopener">Dev.to</a>{{/if}}
        {{#if dribbble}}<a href="{{dribbble}}" rel="noopener">Dribbble</a>{{/if}}
        {{#if behance}}<a href="{{behance}}" rel="noopener">Behance</a>{{/if}}
      </nav>
      {{/with}}
    </aside>
  </header>

  <!-- ================= SUMMARY ================= -->
  {{#if summary}}
  <section class="summary" aria-labelledby="s-profile">
    <h2 class="label" id="s-profile">Profile</h2>
    <div class="summary__body">
      <p class="summary__lead">{{summary}}</p>
      {{#if personal.bio}}<p class="summary__bio">{{personal.bio}}</p>{{/if}}
    </div>
  </section>
  {{/if}}

  <!-- ================= SKILLS ================= -->
  {{#if skills}}
  <section class="section" aria-labelledby="s-skills">
    <div class="section__head">
      <h2 class="section__title" id="s-skills">Skills</h2>
      <span class="section__rule"></span>
    </div>
    <div class="skillgrid">
      {{#each skills}}
      <article class="card skillcard">
        <h3>{{category}}</h3>
        <ul class="skills">
          {{#each items}}
          <li class="skill" data-level="{{level}}">
            <span class="skill__name">{{name}}</span>
            {{#if level}}<span class="skill__level">{{level}}</span>{{/if}}
          </li>
          {{/each}}
        </ul>
      </article>
      {{/each}}
    </div>
  </section>
  {{/if}}

  <!-- ================= EXPERIENCE ================= -->
  {{#if experience}}
  <section class="section" aria-labelledby="s-exp">
    <div class="section__head">
      <h2 class="section__title" id="s-exp">Experience</h2>
      <span class="section__rule"></span>
    </div>
    <div class="timeline">
      {{#each experience}}
      <article class="xp{{#if current}} xp--current{{/if}}">
        <div class="xp__spine" aria-hidden="true"><span class="xp__node"></span></div>
        <div class="card xp__card">
          <div class="xp__top">
            <div class="xp__ident">
              {{#if logo}}<img class="logo" src="{{logo}}" alt="{{company}} logo">{{/if}}
              <div>
                <h3 class="xp__role">{{role}}</h3>
                <p class="xp__org">
                  {{#if url}}
                  <a class="xp__company" href="{{url}}" rel="noopener">{{company}}</a>
                  {{else}}
                  <span class="xp__company">{{company}}</span>
                  {{/if}}
                  {{#if location}}<span class="xp__dot" aria-hidden="true"></span><span class="data">{{location}}</span>{{/if}}
                  {{#if type}}<span class="xp__dot" aria-hidden="true"></span><span class="data xp__type">{{type}}</span>{{/if}}
                </p>
              </div>
            </div>
            <div class="xp__when">
              <p class="xp__dates">
                <time datetime="{{startDate}}" data-date="{{startDate}}">{{startDate}}</time>
                &nbsp;&ndash;&nbsp;
                {{#if current}}Present{{else}}<time datetime="{{endDate}}" data-date="{{endDate}}">{{endDate}}</time>{{/if}}
              </p>
              <span class="label" data-duration data-from="{{startDate}}" data-to="{{endDate}}"></span>
              {{#if current}}<span class="badge">Current</span>{{/if}}
            </div>
          </div>
          {{#if description}}<p class="xp__desc">{{description}}</p>{{/if}}
          {{#if highlights}}
          <ul class="bullets">
            {{#each highlights}}<li>{{this}}</li>{{/each}}
          </ul>
          {{/if}}
          {{#if techStack}}
          <ul class="chips">
            {{#each techStack}}<li class="chip">{{this}}</li>{{/each}}
          </ul>
          {{/if}}
        </div>
      </article>
      {{/each}}
    </div>
  </section>
  {{/if}}

  <!-- ================= PROJECTS ================= -->
  {{#if projects}}
  <section class="section" aria-labelledby="s-proj">
    <div class="section__head">
      <h2 class="section__title" id="s-proj">Projects</h2>
      <span class="section__rule"></span>
    </div>

    <div class="projects--featured">
      {{#each projects}}
      {{#if featured}}
      <article class="card pj">
        <div class="pj__inner">
          {{#if thumbnail}}
          <figure class="pj__shot">
            <img src="{{thumbnail}}" alt="{{name}} preview">
          </figure>
          {{/if}}
          <div class="pj__body">
            <div class="pj__head">
              <div>
                <h3 class="pj__name">{{name}}</h3>
                {{#if tagline}}<p class="pj__tagline">{{tagline}}</p>{{/if}}
              </div>
              <p class="data">
                {{#if category}}<span style="text-transform:capitalize">{{category}}</span>{{/if}}
                {{#if year}}&nbsp;&middot;&nbsp;{{year}}{{/if}}
              </p>
            </div>
            {{#if description}}<p class="pj__desc">{{description}}</p>{{/if}}
            {{#if highlights}}
            <ul class="bullets">
              {{#each highlights}}<li>{{this}}</li>{{/each}}
            </ul>
            {{/if}}
            {{#if techStack}}
            <ul class="chips">
              {{#each techStack}}<li class="chip">{{this}}</li>{{/each}}
            </ul>
            {{/if}}
            {{#if liveUrl}}
            <p class="pj__links">
              <a class="ext" href="{{liveUrl}}" rel="noopener">Live</a>
              {{#if repoUrl}}<a class="ext" href="{{repoUrl}}" rel="noopener">Source</a>{{/if}}
            </p>
            {{else}}
            {{#if repoUrl}}
            <p class="pj__links"><a class="ext" href="{{repoUrl}}" rel="noopener">Source</a></p>
            {{/if}}
            {{/if}}
          </div>
        </div>
      </article>
      {{/if}}
      {{/each}}
    </div>

    <div class="projects--minor">
      {{#each projects}}
      {{#unless featured}}
      <article class="card pj pj--minor">
        <div class="pj__body">
          <div class="pj__head">
            <div>
              <h3 class="pj__name">{{name}}</h3>
              {{#if tagline}}<p class="pj__tagline">{{tagline}}</p>{{/if}}
            </div>
            {{#if year}}<p class="data">{{year}}</p>{{/if}}
          </div>
          {{#if description}}<p class="pj__desc">{{description}}</p>{{/if}}
          {{#if techStack}}
          <ul class="chips">
            {{#each techStack}}<li class="chip">{{this}}</li>{{/each}}
          </ul>
          {{/if}}
          {{#if liveUrl}}
          <p class="pj__links">
            <a class="ext" href="{{liveUrl}}" rel="noopener">Live</a>
            {{#if repoUrl}}<a class="ext" href="{{repoUrl}}" rel="noopener">Source</a>{{/if}}
          </p>
          {{else}}
          {{#if repoUrl}}
          <p class="pj__links"><a class="ext" href="{{repoUrl}}" rel="noopener">Source</a></p>
          {{/if}}
          {{/if}}
        </div>
      </article>
      {{/unless}}
      {{/each}}
    </div>
  </section>
  {{/if}}

  <!-- ================= EDUCATION ================= -->
  {{#if education}}
  <section class="section" aria-labelledby="s-edu">
    <div class="section__head">
      <h2 class="section__title" id="s-edu">Education</h2>
      <span class="section__rule"></span>
    </div>
    <div class="edu">
      {{#each education}}
      <article class="card edu__card">
        <div>
          <h3 class="edu__degree">{{degree}}{{#if field}}, {{field}}{{/if}}</h3>
          <p class="edu__inst">{{institution}}</p>
          <div class="edu__facts">
            {{#if gpa}}<span class="edu__gpa">GPA {{gpa}}</span>{{/if}}
          </div>
          {{#if honors}}
          <ul class="edu__honours">
            {{#each honors}}<li class="honour">{{this}}</li>{{/each}}
          </ul>
          {{/if}}
          {{#if relevantCourses}}
          <div class="edu__courses">
            <p class="label">Coursework</p>
            <ul class="chips">
              {{#each relevantCourses}}<li class="chip">{{this}}</li>{{/each}}
            </ul>
          </div>
          {{/if}}
        </div>
        <p class="xp__dates">
          <time datetime="{{startDate}}" data-date="{{startDate}}">{{startDate}}</time>
          {{#if endDate}}&nbsp;&ndash;&nbsp;<time datetime="{{endDate}}" data-date="{{endDate}}">{{endDate}}</time>{{/if}}
        </p>
      </article>
      {{/each}}
    </div>
  </section>
  {{/if}}

  <!-- ================= CERTIFICATIONS ================= -->
  {{#if certifications}}
  <section class="section" aria-labelledby="s-cert">
    <div class="section__head">
      <h2 class="section__title" id="s-cert">Certifications</h2>
      <span class="section__rule"></span>
    </div>
    <div class="grid-2">
      {{#each certifications}}
      <article class="card">
        <h3 class="tile__title">{{name}}</h3>
        {{#if issuer}}<p class="tile__sub">{{issuer}}</p>{{/if}}
        <div class="tile__meta">
          {{#if date}}<span class="data"><time datetime="{{date}}" data-date="{{date}}">{{date}}</time></span>{{/if}}
          {{#if expiryDate}}<span class="xp__dot" aria-hidden="true"></span><span class="data">Expires <time datetime="{{expiryDate}}" data-date="{{expiryDate}}">{{expiryDate}}</time></span>{{/if}}
        </div>
        {{#if credentialId}}
        <div class="tile__foot">
          <span class="cred">ID {{credentialId}}</span>
          {{#if url}}<a class="ext" href="{{url}}" rel="noopener">Verify</a>{{/if}}
        </div>
        {{else}}
        {{#if url}}
        <div class="tile__foot"><a class="ext" href="{{url}}" rel="noopener">Verify</a></div>
        {{/if}}
        {{/if}}
      </article>
      {{/each}}
    </div>
  </section>
  {{/if}}

  <!-- ================= PUBLICATIONS ================= -->
  {{#if publications}}
  <section class="section" aria-labelledby="s-pubs">
    <div class="section__head">
      <h2 class="section__title" id="s-pubs">Writing</h2>
      <span class="section__rule"></span>
    </div>
    <ul class="pubs">
      {{#each publications}}
      <li class="pub">
        <div>
          <h3 class="pub__title">{{title}}</h3>
          <div class="pub__meta">
            {{#if publisher}}<span class="pub__pub">{{publisher}}</span>{{/if}}
            {{#if date}}<span class="xp__dot" aria-hidden="true"></span><span class="data"><time datetime="{{date}}" data-date="{{date}}">{{date}}</time></span>{{/if}}
            {{#if type}}<span class="xp__dot" aria-hidden="true"></span><span class="data pub__type">{{type}}</span>{{/if}}
          </div>
        </div>
        {{#if url}}<a class="ext" href="{{url}}" rel="noopener">Read</a>{{/if}}
      </li>
      {{/each}}
    </ul>
  </section>
  {{/if}}

  <!-- ================= TALKS ================= -->
  {{#if talks}}
  <section class="section" aria-labelledby="s-talks">
    <div class="section__head">
      <h2 class="section__title" id="s-talks">Speaking</h2>
      <span class="section__rule"></span>
    </div>
    <div class="grid-2">
      {{#each talks}}
      <article class="card">
        <h3 class="tile__title">{{title}}</h3>
        {{#if event}}<p class="tile__sub">{{event}}</p>{{/if}}
        <div class="tile__meta">
          {{#if date}}<span class="data"><time datetime="{{date}}" data-date="{{date}}">{{date}}</time></span>{{/if}}
          {{#if location}}<span class="xp__dot" aria-hidden="true"></span><span class="data">{{location}}</span>{{/if}}
          {{#if type}}<span class="xp__dot" aria-hidden="true"></span><span class="data xp__type">{{type}}</span>{{/if}}
        </div>
        {{#if slidesUrl}}
        <div class="tile__foot">
          <a class="ext" href="{{slidesUrl}}" rel="noopener">Slides</a>
          {{#if videoUrl}}<a class="ext" href="{{videoUrl}}" rel="noopener">Video</a>{{/if}}
        </div>
        {{else}}
        {{#if videoUrl}}
        <div class="tile__foot"><a class="ext" href="{{videoUrl}}" rel="noopener">Video</a></div>
        {{/if}}
        {{/if}}
      </article>
      {{/each}}
    </div>
  </section>
  {{/if}}

  <!-- ================= AWARDS ================= -->
  {{#if awards}}
  <section class="section" aria-labelledby="s-awards">
    <div class="section__head">
      <h2 class="section__title" id="s-awards">Recognition</h2>
      <span class="section__rule"></span>
    </div>
    <div class="grid-2">
      {{#each awards}}
      <article class="card award">
        <h3 class="tile__title">{{title}}</h3>
        <div class="tile__meta">
          {{#if issuer}}<span class="tile__sub" style="margin-top:0">{{issuer}}</span>{{/if}}
          {{#if date}}<span class="xp__dot" aria-hidden="true"></span><span class="data"><time datetime="{{date}}" data-date="{{date}}">{{date}}</time></span>{{/if}}
        </div>
        {{#if description}}<p class="xp__desc">{{description}}</p>{{/if}}
      </article>
      {{/each}}
    </div>
  </section>
  {{/if}}

  <!-- ================= VOLUNTEER ================= -->
  {{#if volunteer}}
  <section class="section" aria-labelledby="s-vol">
    <div class="section__head">
      <h2 class="section__title" id="s-vol">Volunteering</h2>
      <span class="section__rule"></span>
    </div>
    <div class="grid-2">
      {{#each volunteer}}
      <article class="card">
        <h3 class="tile__title">{{role}}</h3>
        {{#if url}}
        <p><a class="tile__sub" href="{{url}}" rel="noopener">{{organization}}</a></p>
        {{else}}
        <p class="tile__sub">{{organization}}</p>
        {{/if}}
        <div class="tile__meta">
          <span class="data">
            <time datetime="{{startDate}}" data-date="{{startDate}}">{{startDate}}</time>
            &nbsp;&ndash;&nbsp;
            {{#if current}}Present{{else}}<time datetime="{{endDate}}" data-date="{{endDate}}">{{endDate}}</time>{{/if}}
          </span>
          {{#if current}}<span class="badge">Active</span>{{/if}}
        </div>
        {{#if description}}<p class="xp__desc">{{description}}</p>{{/if}}
      </article>
      {{/each}}
    </div>
  </section>
  {{/if}}

  <!-- ================= LANGUAGES ================= -->
  {{#if languages}}
  <section class="section" aria-labelledby="s-lang">
    <div class="section__head">
      <h2 class="section__title" id="s-lang">Languages</h2>
      <span class="section__rule"></span>
    </div>
    <ul class="pills">
      {{#each languages}}
      <li class="lang">
        <span class="lang__name">{{language}}</span>
        {{#if proficiency}}<span class="lang__prof">{{proficiency}}</span>{{/if}}
      </li>
      {{/each}}
    </ul>
  </section>
  {{/if}}

  <!-- ================= INTERESTS ================= -->
  {{#if interests}}
  <section class="section" aria-labelledby="s-int">
    <div class="section__head">
      <h2 class="section__title" id="s-int">Interests</h2>
      <span class="section__rule"></span>
    </div>
    <ul class="pills">
      {{#each interests}}<li class="interest">{{this}}</li>{{/each}}
    </ul>
  </section>
  {{/if}}

  <!-- ================= TESTIMONIALS ================= -->
  {{#if testimonials}}
  <section class="section" aria-labelledby="s-refs">
    <div class="section__head">
      <h2 class="section__title" id="s-refs">References</h2>
      <span class="section__rule"></span>
    </div>
    <div class="quotes">
      {{#each testimonials}}
      <figure class="card quote">
        <blockquote>{{quote}}</blockquote>
        <figcaption>
          {{#if photo}}<img src="{{photo}}" alt="{{author}}">{{/if}}
          <span>
            <span class="quote__who">{{author}}</span>
            {{#if role}}<span class="quote__role">{{role}}{{#if company}} &middot; {{company}}{{/if}}</span>{{/if}}
          </span>
        </figcaption>
      </figure>
      {{/each}}
    </div>
  </section>
  {{/if}}

  <!-- ================= FOOT ================= -->
  <footer class="foot">
    <p class="label">{{personal.displayName}}{{#if personal.title}} &middot; {{personal.title}}{{/if}}</p>
    {{#if meta.lastUpdated}}<p class="label">Updated <time datetime="{{meta.lastUpdated}}" data-date="{{meta.lastUpdated}}">{{meta.lastUpdated}}</time></p>{{/if}}
  </footer>

</main>

<script>
/* Formats ISO-ish dates (2022-03 / 2016) into readable labels and derives
   role durations, so the template needs no Handlebars helpers. Without JS the
   raw values still render, so nothing is lost. */
(function () {
  var M = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];

  function parse(v) {
    if (!v) return null;
    var p = String(v).trim().split('-');
    var y = parseInt(p[0], 10);
    if (!y) return null;
    var m = p[1] ? parseInt(p[1], 10) : null;
    return { y: y, m: (m >= 1 && m <= 12) ? m : null };
  }

  function label(d) {
    return d.m ? M[d.m - 1] + ' ' + d.y : String(d.y);
  }

  var dates = document.querySelectorAll('[data-date]');
  for (var i = 0; i < dates.length; i++) {
    var d = parse(dates[i].getAttribute('data-date'));
    if (d) dates[i].textContent = label(d);
  }

  var spans = document.querySelectorAll('[data-duration]');
  for (var j = 0; j < spans.length; j++) {
    var from = parse(spans[j].getAttribute('data-from'));
    if (!from) continue;
    var to = parse(spans[j].getAttribute('data-to'));
    if (!to) {
      var now = new Date();
      to = { y: now.getFullYear(), m: now.getMonth() + 1 };
    }
    var months = (to.y - from.y) * 12 + ((to.m || 1) - (from.m || 1)) + 1;
    if (months < 1) months = 1;
    var yrs = Math.floor(months / 12);
    var mos = months % 12;
    var out = [];
    if (yrs) out.push(yrs + ' yr' + (yrs > 1 ? 's' : ''));
    if (mos) out.push(mos + ' mo' + (mos > 1 ? 's' : ''));
    spans[j].textContent = out.join(' ');
  }
})();
</script>
</body>
</html>
